{
  "name": "template-typescript-monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel --stream dev",
    "start": "pnpm --filter tan-start-app start",
    "cli": "pnpm --filter cli start",
    "clean": "rimraf dist packages/**/dist apps/**/dist apps/**/.nitro apps/**/.tanstack apps/**/.output *.tsbuildinfo packages/**/*.tsbuildinfo apps/**/*.tsbuildinfo",
    "clean:all": "pnpm clean &&rimraf node_modules packages/**/node_modules apps/**/node_modules",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "pnpm -r --filter \"!tan-start-app\" exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.next,build",
    "gcloud": "gcloud auth application-default login && gcloud config set project bhouston-general-hosting && gcloud config set run/region us-central1",
    "depcheck": "npx depcheck",
    "release": "semantic-release"
  },
  "dependencies": {
    "rimraf": "^6.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vinxi": "^0.5.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
